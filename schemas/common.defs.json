{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.learning-assistance/schemas/common.defs.json",
  "title": "Shared definitions for AI Learning Copilot data contracts",
  "description": "枚举与通用结构的唯一来源。AGENTS.md 第 4 节统一词表在本文件的机械体现；任何 Skill Schema 不得自行复制枚举值，只能 $ref 到这里（R8）。",
  "$defs": {
    "student_id": {
      "type": "string",
      "pattern": "^stu_[0-9a-f]{4}$",
      "description": "pseudonymous ID，由 scripts/new_id.py 生成，禁止模型编造（R23）"
    },
    "knowledge_point_id": {
      "type": "string",
      "pattern": "^g7\\.math\\.[ab][0-9]{2}\\.[0-9]{2}\\.[0-9]{2}$",
      "description": "知识点 ID，只允许来自 knowledge-base/grade-7-math.json（R14）。无法映射时本数组留空并用 knowledge_mapping_status 表达（R13）"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^ev_stu_[0-9a-f]{4}_[0-9]{4,}$",
      "description": "append-only 证据 ID（R22）"
    },
    "homework_id": {
      "type": "string",
      "pattern": "^hw_[0-9]{8}_[0-9]{3}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^plan_[0-9]{8}_[0-9]{3}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^ts_[0-9]{8}_[0-9]{3}$"
    },
    "question_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,31}$",
      "maxLength": 32
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,63}$"
    },
    "semantic_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "prompt_version": {
      "type": "string",
      "pattern": "^v[0-9]+(\\.[0-9]+)*(-[a-z0-9]+)?$",
      "description": "回归对比依赖此字段（ADR-0004）"
    },
    "date_time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "ISO 8601 带时区。用 pattern 而非 format，因为本项目默认不启用 format 校验（避免依赖 format 插件）"
    },
    "mastery_status": {
      "enum": ["mastered", "developing", "needs_support", "unknown"]
    },
    "error_type": {
      "enum": [
        "correct",
        "calculation_error",
        "concept_error",
        "method_error",
        "incomplete",
        "unreadable",
        "needs_human_check"
      ]
    },
    "verification_status": {
      "enum": ["program_verified", "model_checked", "needs_human_check", "not_applicable"]
    },
    "independence": {
      "enum": ["independent", "assisted", "not_attempted"]
    },
    "relation_type": {
      "enum": [
        "PREREQUISITE",
        "CONTAINS",
        "RELATED",
        "SIMILAR",
        "EASILY_CONFUSED",
        "TRANSFER_TO"
      ]
    },
    "review_status": {
      "enum": ["reviewed", "pending_review", "rejected"]
    },
    "knowledge_mapping_status": {
      "enum": ["mapped", "partial", "unmapped"]
    },
    "question_kind": {
      "enum": ["basic", "variation", "transfer", "verification", "diagnostic_probe", "unknown"]
    },
    "hint_level": {
      "enum": [0, 1, 2, 3, 4],
      "description": "0 无提示 1 概念提醒 2 解题方向 3 关键步骤提示 4 worked example"
    },
    "explanation_quality": {
      "enum": ["none", "partial", "adequate", "thorough"]
    },
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1,
      "description": "无依据时必须为 null，禁止取中间值充数（AGENTS.md 第 4 节）"
    },
    "confidence_basis": {
      "type": "string",
      "minLength": 3,
      "maxLength": 400,
      "description": "说明 confidence 数字从何而来；与 confidence 成对出现"
    },
    "observation": {
      "type": "string",
      "minLength": 5,
      "maxLength": 600,
      "description": "只陈述观察到的事实，不含因果推断（R10）"
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "needs_verification"],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 5,
          "maxLength": 600
        },
        "needs_verification": {
          "type": "boolean"
        },
        "verification_question_id": {
          "$ref": "#/$defs/question_id"
        },
        "alternative_explanations": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "maxItems": 5
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidence_count", "basis"],
      "properties": {
        "value": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "evidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "basis": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_count": {
                "const": 0
              }
            },
            "required": ["evidence_count"]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          },
          "description": "没有证据的维度不得编造数值（R16、原方案诊断原则）"
        }
      ]
    },
    "completion_setting": {
      "enum": ["classroom", "home_supervised", "home_unsupervised", "unknown"],
      "description": "作业完成场景。independence 维度对此敏感，默认 unknown（skill-contracts.md Q1 缺口 1）"
    },
    "relation_origin": {
      "enum": ["human", "inferred"],
      "description": "关系边的来源。inferred 且未过 REVIEW-QUEUE 的边禁止用于给出掌握度结论（ADR-0006）。由 scripts/validate_knowledge_base.py 消费"
    }
  }
}
