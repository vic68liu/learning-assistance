{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.learning-assistance/schemas/knowledge-point.schema.json",
  "title": "Knowledge Base File (grade-7-math.json)",
  "description": "知识点知识库的结构契约。该文件由人工审核维护，模型只读（R14）。知识点 ID 的文法与废弃策略见 docs/decisions/ADR-0006。关系文件 knowledge-relations.json 的结构校验目前由 scripts/validate_knowledge_base.py 承担。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "grade",
    "textbook_version",
    "review_status",
    "scope",
    "knowledge_points"
  ],
  "properties": {
    "schema_version": { "$ref": "common.defs.json#/$defs/semantic_version" },
    "subject": { "enum": ["math"] },
    "grade": { "type": "string", "pattern": "^g[0-9]{2}$" },
    "textbook_version": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "description": "必须可追溯到实体书版权页/目录页。未核对时须含\"待实体书核对\"字样（REVIEW-QUEUE 第 1 项）"
    },
    "curriculum_standard_version": { "type": ["string", "null"], "maxLength": 64 },
    "review_status": { "$ref": "common.defs.json#/$defs/review_status" },
    "reviewed_by": { "type": ["string", "null"], "maxLength": 64 },
    "reviewed_at": { "anyOf": [ { "$ref": "common.defs.json#/$defs/date_time" }, { "type": "null" } ] },
    "provenance_note": {
      "type": ["string", "null"],
      "maxLength": 4000,
      "description": "记录本文件的来源与局限（谁提供的大纲、哪些是推断、哪些教材内容未建模）。R13/R14 的审计入口"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["volumes", "chapters", "excluded"],
      "properties": {
        "volumes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["七上", "七下"] }
        },
        "chapters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/chapter" }
        },
        "excluded": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "title", "reason"],
            "properties": {
              "code": { "type": "string", "pattern": "^[ab][0-9]{2}$" },
              "title": { "type": "string", "minLength": 1, "maxLength": 120 },
              "reason": { "type": "string", "minLength": 5, "maxLength": 600 },
              "revisit_condition": { "type": ["string", "null"], "maxLength": 300 }
            }
          },
          "description": "显式记录被排除的章与原因，避免\"没做\"被误读成\"不需要\""
        }
      }
    },
    "knowledge_points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 400,
      "items": { "$ref": "#/$defs/knowledge_point" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "review_status": { "const": "reviewed" } }, "required": ["review_status"] },
      "then": {
        "required": ["reviewed_by", "reviewed_at"],
        "properties": {
          "reviewed_by": { "type": "string", "minLength": 2 },
          "reviewed_at": { "type": "string" }
        }
      },
      "description": "声称 reviewed 就必须留下审核人与时间，否则状态无凭据（R25）"
    }
  ],

  "$defs": {
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "title", "volume"],
      "properties": {
        "code": { "type": "string", "pattern": "^[ab][0-9]{2}$" },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "照抄教材目录原文（R13）"
        },
        "volume": { "enum": ["七上", "七下"] },
        "source_pages": { "type": ["string", "null"], "maxLength": 32 }
      }
    },
    "knowledge_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "chapter_code",
        "section_code",
        "section_title",
        "title",
        "origin",
        "review_status"
      ],
      "properties": {
        "id": { "$ref": "common.defs.json#/$defs/knowledge_point_id" },
        "chapter_code": { "type": "string", "pattern": "^[ab][0-9]{2}$" },
        "section_code": { "type": "string", "pattern": "^[0-9]{2}$" },
        "section_title": { "type": "string", "minLength": 2, "maxLength": 120 },
        "subsection_title": {
          "type": ["string", "null"],
          "maxLength": 120,
          "description": "教材三级标题（如 4.1.1 单项式）。不进 ID（ADR-0006）"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "诊断单元名。教材有此层级则照抄；否则按粒度规则命名，且必须能独立出一道验证题"
        },
        "origin": { "enum": ["human_outline", "inferred"] },
        "review_status": { "$ref": "common.defs.json#/$defs/review_status" },
        "reviewed_by": { "type": ["string", "null"], "maxLength": 64 },
        "reviewed_at": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "deprecated": { "type": "boolean" },
        "deprecated_at": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "deprecated_reason": { "type": ["string", "null"], "maxLength": 400 },
        "replacement_ids": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "common.defs.json#/$defs/knowledge_point_id" }
        },
        "source_pages": { "type": ["string", "null"], "maxLength": 32 },
        "expected_error_patterns": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 3, "maxLength": 300 },
          "description": "人工观察的高频错误，用于生成测试用例（不得由模型填充，R13）"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "deprecated": { "const": true } }, "required": ["deprecated"] },
          "then": {
            "required": ["deprecated_at", "deprecated_reason"],
            "properties": {
              "deprecated_at": { "type": "string" },
              "deprecated_reason": { "type": "string", "minLength": 5 }
            }
          },
          "description": "废弃必须可解释（ADR-0006：禁止物理删除，废弃须留原因）"
        },
        {
          "if": { "properties": { "review_status": { "const": "reviewed" } }, "required": ["review_status"] },
          "then": {
            "properties": {
              "reviewed_by": { "type": "string", "minLength": 2 },
              "reviewed_at": { "type": "string" }
            },
            "required": ["reviewed_by", "reviewed_at"]
          }
        }
      ]
    }
  },

  "examples": [
    {
      "schema_version": "1.0.0",
      "subject": "math",
      "grade": "g07",
      "textbook_version": "人教版 2024 秋版 七年级上册（待实体书核对）",
      "curriculum_standard_version": "2022",
      "review_status": "pending_review",
      "reviewed_by": null,
      "reviewed_at": null,
      "scope": {
        "volumes": ["七上"],
        "chapters": [
          { "code": "a04", "title": "第四章 整式的加减", "volume": "七上", "source_pages": null },
          { "code": "a02", "title": "第二章 有理数的运算", "volume": "七上", "source_pages": null }
        ],
        "excluded": [
          {
            "code": "a06",
            "title": "第六章 几何图形初步",
            "reason": "sympy 无法符号验算图形题，且图像输入路径未经 spike 验证，会污染 benchmark 归因",
            "revisit_condition": "OCR spike 通过后再建模"
          }
        ]
      },
      "knowledge_points": [
        {
          "id": "g7.math.a04.02.04",
          "chapter_code": "a04",
          "section_code": "02",
          "section_title": "4.2 整式的加法与减法",
          "subsection_title": null,
          "title": "去括号（括号前为负号，逐项变号）",
          "origin": "human_outline",
          "review_status": "pending_review",
          "reviewed_by": null,
          "reviewed_at": null,
          "deprecated": false,
          "deprecated_at": null,
          "deprecated_reason": null,
          "replacement_ids": [],
          "source_pages": null,
          "expected_error_patterns": ["只对首项变号、常数项漏变号"]
        },
        {
          "id": "g7.math.a02.03.01",
          "chapter_code": "a02",
          "section_code": "03",
          "section_title": "2.3 有理数的乘方",
          "subsection_title": "2.3.1 乘方",
          "title": "幂的底数、指数与 -a^n 与 (-a)^n 的区别",
          "origin": "human_outline",
          "review_status": "pending_review",
          "reviewed_by": null,
          "reviewed_at": null,
          "deprecated": false,
          "deprecated_at": null,
          "deprecated_reason": null,
          "replacement_ids": [],
          "source_pages": null,
          "expected_error_patterns": ["负号未进括号却当作底数的一部分"]
        }
      ]
    }
  ]
}
