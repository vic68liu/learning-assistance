# ============================================================
# 行尾策略：仓库内统一 LF；Windows 工作区checkout 也保持 LF，
# 避免 .sh 脚本被 CRLF 破坏（bash 会报 $'\r': command not found）
# ============================================================
* text=auto eol=lf

*.sh   text eol=lf
*.bash text eol=lf

*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.csv  text eol=lf
*.txt  text eol=lf

# ---------- 二进制：禁止任何行尾/文本处理 ----------
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.heic binary
*.gif  binary
*.tif  binary
*.tiff binary
*.pdf  binary
*.mp3  binary
*.m4a  binary
*.wav  binary

# ---------- 差异友好 ----------
*.json diff=json
